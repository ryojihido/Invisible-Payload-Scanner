      "id": "tanstack-mini-shai-hulud-2026-05",
      "name": "TanStack npm supply-chain IOC rules",
      "sourceNote": "Based on the TanStack postmortem and GitHub Security Advisory GHSA-g7cv-rxg3-hmpx. Update manually as public advisories change.",
      "stringIocs": [
        "github:tanstack/router#79ac49eedf774dd4b0cfa308722bc463cfe5885c",
        "@tanstack/setup",
        "router_init.js",
        "router_init",
        "tanstack_runner.js",
        "tanstack_runner",
        "filev2.getsession.org",
        "seed1.getsession.org",
        "seed2.getsession.org",
        "seed3.getsession.org",
        "litter.catbox.moe/h8nc9u.js",
        "litter.catbox.moe/7rrc6l.mjs",
        "Linux-pnpm-store-6f9233a50def742c09fde54f56553d6b449a535adf87d4083690539f49ae4da11",
        "claude@users.noreply.github.com",
        "voicproducoes",
        "zblgg"
      ],
      "packageRules": [
        {
          "namePattern": "^@tanstack/(query|query-core|react-query|solid-query|svelte-query|vue-query|angular-query|eslint-plugin-query|table|react-table|solid-table|svelte-table|vue-table|form|react-form|solid-form|vue-form|virtual|react-virtual|solid-virtual|svelte-virtual|vue-virtual|store)$",
          "severity": "info",
          "message": "TanStack clean-family package name found. This is not automatically malicious; check version and IoCs."
        },
        {
          "namePattern": "^@tanstack/",
          "severity": "medium",
          "message": "TanStack package name found. Package name alone is not a malicious indicator; check version and IoCs."
        },
        {
          "namePattern": "^@(opensearch-project|mistralai|uipath|squawk)/",
          "severity": "low",
          "message": "Package namespace has appeared in public supply-chain discussions. Treat this as a prompt to verify official advisories, not as a malicious finding."
        },
        {
          "namePattern": "^guardrails-ai$",
          "severity": "low",
          "message": "Package name has appeared in public supply-chain discussions. Treat this as a prompt to verify official advisories, not as a malicious finding."
        }
      ],
